# Copy this file to ira/.env.local, fill in both keys, then restart `npm run dev`.
# The app will not run without them.

# Required. Nessie bank API: http://api.nessieisreal.com (sign in, copy your key).
# After setting it, run `npm run seed` once to create the demo people.
NESSIE_API_KEY=

# Required. Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default is set in lib/ai/gemini.ts).
# GEMINI_MODEL=

# NEXT_PUBLIC_BRAND=tfs  # only with Toyota Financial Services sign-off
